# Copy to .env and fill in only what you use. Never commit .env.
# Every key is optional: Stagorix runs free by default.

# LLM providers (pick one or more; see docs/ARCHITECTURE.md)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_HOST=http://localhost:11434

# Stock assets
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Optional integrations
NOTION_TOKEN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
